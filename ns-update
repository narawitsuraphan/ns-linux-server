#!/bin/bash
set -e

# ANSI Color Codes
C_CYAN='\033[1;36m'
C_GREEN='\033[1;32m'
C_YELLOW='\033[1;33m'
C_RED='\033[1;31m'
C_RESET='\033[0m'

REPO_RAW="https://raw.githubusercontent.com/narawitsuraphan/ns-linux-server/main"

echo -e "${C_CYAN}====================================================${C_RESET}"
echo -e "       ${C_YELLOW}NS Linux Server - OTA System Updater${C_RESET}"
echo -e "         Maintained by NARAWIT SURAPHAN"
echo -e "${C_CYAN}====================================================${C_RESET}"

# 1. ตรวจสอบสิทธิ์ Root
if [ "$(id -u)" -ne 0 ]; then
    echo -e "${C_RED}[Error] Please run ns-update as root (or use sudo).${C_RESET}"
    exit 1
fi

# 2. ซิงก์เวลาระบบ
echo -e "\n${C_GREEN}[1/5] Synchronizing system clock...${C_RESET}"
date -s "$(curl -sI https://google.com 2>/dev/null | grep -i '^date:' | cut -d' ' -f2-)" >/dev/null 2>&1 || true
hwclock --systohc 2>/dev/null || true
echo "Clock synchronized."

# 3. ตรวจสอบและอัปเดตสคริปต์ ns-update ตัวเอง
echo -e "\n${C_GREEN}[2/5] Checking for updater engine updates...${C_RESET}"
curl -fsSL "${REPO_RAW}/ns-update" -o /usr/local/bin/ns-update.tmp 2>/dev/null && {
    mv /usr/local/bin/ns-update.tmp /usr/local/bin/ns-update
    chmod +x /usr/local/bin/ns-update
    echo "Updater engine updated successfully."
} || echo "Using local updater engine."

# 4. ดึง Welcome Banner ล่าสุด
echo -e "\n${C_GREEN}[3/5] Syncing latest Welcome Banner from Cloud...${C_RESET}"
curl -fsSL "${REPO_RAW}/scripts/ns-welcome.sh" -o /etc/profile.d/ns-welcome.sh
chmod +x /etc/profile.d/ns-welcome.sh
echo "Banner updated successfully."

# 5. รันสคริปต์โมระบบ / แพตช์ระบบจาก Cloud
echo -e "\n${C_GREEN}[4/5] Checking and applying remote patches...${C_RESET}"
curl -fsSL "${REPO_RAW}/scripts/ns-patch.sh" -o /tmp/ns-patch.sh && {
    chmod +x /tmp/ns-patch.sh
    /tmp/ns-patch.sh
    rm -f /tmp/ns-patch.sh
} || echo "No remote patches executed."

# 6. ล้างแคชและขยะในระบบ
echo -e "\n${C_GREEN}[5/5] Cleaning system cache...${C_RESET}"
apt autoremove -y
apt clean

echo -e "\n${C_CYAN}====================================================${C_RESET}"
echo -e "${C_GREEN}[✓] This NS Linux Server is completely up-to-date!${C_RESET}"
echo -e "${C_CYAN}====================================================${C_RESET}\n"
